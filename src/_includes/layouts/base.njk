{#-
  Port of resources/views/common/navigations/site_header.blade.php + site_footer.blade.php.
  Every page sets: pageTitle (without the " | Find Contractors" suffix — added here, exactly
  like the Blade header did), pageDescription, optional canonical, noindex, clickcease.
-#}
{%- set finalTitle = ((pageTitle or site.name) | replace(site.titleSuffix, "") | trim) + site.titleSuffix -%}
{%- set canonicalUrl = canonical or (site.url + (page.url | cleanUrl)) -%}
{%- set isNoindex = (noindex == true or noindex == "true") or (pg.noindex if pg else false) -%}
{%- set schemaObj = schema or (pg.schema if pg else null) -%}
<!DOCTYPE HTML>
<html lang="en-US">
<head>
<meta charset="UTF-8">
<meta http-equiv="x-ua-compatible" content="ie=edge">
<meta name="robots" content="{% if isNoindex %}noindex, follow{% else %}index, follow{% endif %}">

<title>{{ finalTitle }}</title>

<meta name="description" content="{{ pageDescription or '' }}">

<!-- Open Graph -->
<meta property="og:title" content="{{ finalTitle }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ canonicalUrl }}">
<meta property="og:description" content="{{ pageDescription or '' }}">

<!-- Twitter -->
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ finalTitle }}">
<meta name="twitter:description" content="{{ pageDescription or '' }}">

<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="canonical" href="{{ canonicalUrl }}">

<!-- Favicon -->
<link rel="icon" type="image/png" sizes="56x56" href="{{ site.favicon }}">

<!-- CSS Files -->
<link rel="stylesheet" href="/css/bootstrap.min.css">
<link rel="stylesheet" href="/css/owl.carousel.min.css">
<link rel="stylesheet" href="/css/nivo-slider.css">
<link rel="stylesheet" href="/css/animate.css">
<link rel="stylesheet" href="/css/animated-text.css">
<link rel="stylesheet" href="/css/all.min.css">
<link rel="stylesheet" href="/css/flaticon.css">
<link rel="stylesheet" href="/css/theme-default.css">
<link rel="stylesheet" href="/css/meanmenu.min.css">
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/owl.transitions.css">
<link rel="stylesheet" href="/venobox/venobox.css">
<link rel="stylesheet" href="/css/widget.css">
<link rel="stylesheet" href="/css/responsive.css">
<link rel="stylesheet" href="/css/slick.css">
<link rel="stylesheet" href="/css/slick-theme.css">

<script src="/js/vendor/modernizr-3.5.0.min.js"></script>

<!-- Google Analytics -->
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.ga4 }}"></script>
<script>
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '{{ site.ga4 }}');
</script>
{% if site.form.turnstileSiteKey %}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
{% endif %}

<style>
    .slider-content h1 { font-size: 45px; }
    .blog_area .owl-carousel .owl-item img,
    .single_blog_thumb img { height: 350px; width: 100%; object-fit: cover; }
    .popular-post-thumb img { height: 100px; width: 200px; object-fit: cover; }
    .dreamit-feature-single-box2:before {
        background: url("/images/resource/commercial.jpg") no-repeat center/cover;
    }
    .mean-container .mean-bar::before {
        content: "";
        background-image: url("{{ site.logo }}");
        background-size: contain;
        background-repeat: no-repeat;
        width: 80px; height: 80px;
        position: absolute; top: 5px; left: 10px;
    }
    .mean-container .mean-bar { min-height: 85px; }
    .dreamit-section-title h2 { font-size: 30px; }
    .logo img { width: 55%; }
    .breatcumb-title h1 { font-size: 55px; font-weight: 600; margin-bottom: 10px; color: #fff; }
    /* Web3Forms + Turnstile bits that had no equivalent in the Laravel build */
    .cf-turnstile { margin: 6px 0 10px; }
    .form-note { font-size: 12px; color: #777; margin-top: 6px; }
</style>

<meta name="google-site-verification" content="{{ site.googleSiteVerification }}" />
{% if schemaObj %}
<script type="application/ld+json">{{ schemaObj | jsonld | safe }}</script>
{% endif %}
</head>
<body>
{% if clickcease and site.clickcease %}
<!--  ClickCease.com tracking-->
      <script type='text/javascript'>var script = document.createElement('script');
      script.async = true; script.type = 'text/javascript';
      var target = 'https://www.clickcease.com/monitor/stat.js';
      script.src = target;var elem = document.head;elem.appendChild(script);
      </script>
      <noscript>
      <a href='https://www.clickcease.com' rel='nofollow'><img src='https://monitor.clickcease.com' alt='ClickCease'/></a>
      </noscript>
<!--  ClickCease.com tracking-->
{% endif %}

