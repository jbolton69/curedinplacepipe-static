<style>
    .project-count { display:inline-block; background:#fc9615; color:#fff; font-size:13px; font-weight:700; border-radius:12px; padding:2px 10px; margin-left:8px; vertical-align:middle; }
    .project-rows { display:flex; flex-direction:column; gap:14px; }
    .project-row { display:flex; background:#fff; border:1px solid #e6e6e6; border-left:4px solid #fc9615; border-radius:8px; overflow:hidden; text-decoration:none; color:inherit; transition:box-shadow .15s, transform .15s; }
    .project-row:hover { box-shadow:0 6px 22px rgba(0,0,0,.10); transform:translateY(-1px); text-decoration:none; color:inherit; }
    .project-row-media { flex:0 0 190px; background:#f1f6fc; display:flex; align-items:center; justify-content:center; }
    .project-row-media img { width:100%; height:100%; object-fit:cover; display:block; }
    .project-row-stat { text-align:center; padding:18px 10px; }
    .project-row-stat-num { display:block; font-size:30px; font-weight:800; color:#fc9615; line-height:1.1; }
    .project-row-stat-label { display:block; font-size:12px; color:#666; text-transform:uppercase; letter-spacing:.5px; margin-top:4px; }
    .project-row-body { flex:1; padding:14px 18px; min-width:0; }
    .project-row-meta { font-size:12px; color:#777; margin-bottom:4px; }
    .project-row-title { font-size:18px; font-weight:700; color:#1c1c24; margin:0 0 6px; line-height:1.3; }
    .project-row-summary { font-size:14px; color:#555; margin:0 0 8px; line-height:1.55; }
    .project-row-link { font-weight:700; color:#fc9615; font-size:14px; }
    .project-more-btn { background:#1c1c24; color:#fff; padding:10px 26px; border-radius:5px; font-weight:600; }
    .project-more-btn:hover { background:#fc9615; color:#fff; }
    @media (max-width:575px) { .project-row { flex-direction:column; } .project-row-media { flex-basis:auto; } .project-row-stat { padding:12px; } }

    /* Completed-projects slider (full-width, page bottom) */
    .project-slider-area { background:#f7f9fb; }
    .project-slider { position:relative; }
    .project-slider-track { display:flex; gap:16px; overflow-x:auto; scroll-snap-type:x mandatory; scroll-behavior:smooth; padding:4px 2px 16px; -webkit-overflow-scrolling:touch; }
    .project-slider-track::-webkit-scrollbar { height:6px; }
    .project-slider-track::-webkit-scrollbar-thumb { background:#cfd6dd; border-radius:3px; }
    .project-slider-track .project-row { flex:0 0 320px; max-width:320px; scroll-snap-align:start; flex-direction:column; }
    .project-slider-track .project-row-media { flex:0 0 150px; width:100%; }
    .project-slider-track .project-row-stat { padding:26px 10px; }
    .project-slider-arrow { position:absolute; top:42%; transform:translateY(-50%); z-index:2; width:42px; height:42px; border-radius:50%; border:none; background:#1c1c24; color:#fff; font-size:18px; line-height:1; cursor:pointer; box-shadow:0 3px 12px rgba(0,0,0,.18); display:none; align-items:center; justify-content:center; transition:background .15s; }
    .project-slider-arrow:hover { background:#fc9615; color:#fff; }
    .project-slider-arrow:disabled { opacity:.35; cursor:default; background:#1c1c24; }
    .project-slider-prev { left:-8px; }
    .project-slider-next { right:-8px; }
    .project-slider.has-overflow .project-slider-arrow { display:flex; }
    @media (max-width:575px) { .project-slider-track .project-row { flex:0 0 82%; max-width:82%; } .project-slider-prev { left:0; } .project-slider-next { right:0; } }
</style>
