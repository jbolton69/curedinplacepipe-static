---
layout: layouts/base.njk
pagination:
  data: model.projectPages
  size: 1
  alias: pg
permalink: "{{ pg.url }}.html"
eleventyComputed:
  pageTitle: "{{ pg.title | safe }}"
  pageDescription: "{{ pg.description | safe }}"
  h1: "{{ pg.h1 | safe }}"
---
{#- Port of resources/views/contractor/project.blade.php -#}
{%- set c = pg.c -%}
{%- set p = pg.p -%}
{%- set short = pg.short -%}
{%- set hero_image = "/images/cipp/cipp-liner-equipment.jpg" -%}
{% include "partials/breadcrumb-css.njk" %}
<style>
    @media (min-width:1200px) { .container2 { max-width: 1350px; } }
    .project-body p { margin: 0 0 10px; line-height: 1.6; }
    .project-body h2, .project-body h3, .project-body h4 { margin-top: 24px; margin-bottom: 8px; }
    .project-facts { border:1px solid #fc9615; padding: 14px 16px; margin-bottom: 20px; }
    .project-facts dl { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: 4px 14px; }
    .project-facts dt { font-weight: 600; color: #333; }
    .project-facts dd { margin: 0; color: #555; }
    .project-gallery img { width: 100%; height: 220px; object-fit: cover; border-radius: 6px; margin-bottom: 14px; }
    .project-gallery img.generated { height: auto; aspect-ratio: 40 / 21; object-fit: contain; }
    .walt-video { display:flex; gap:22px; align-items:stretch; background:#0d1f3f; color:#fff; border-radius:8px; padding:20px 22px; margin-bottom:22px; }
    .walt-video .wv-frame { flex:0 0 220px; aspect-ratio:9/16; border-radius:10px; overflow:hidden; position:relative; background:#000; cursor:pointer; align-self:flex-start; }
    .walt-video .wv-frame img, .walt-video .wv-frame iframe { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; border:0; }
    .walt-video .wv-play { position:absolute; left:50%; top:50%; width:64px; height:64px; margin:-32px 0 0 -32px; border-radius:50%; background:rgba(255,212,0,.95); display:flex; align-items:center; justify-content:center; box-shadow:0 6px 20px rgba(0,0,0,.45); }
    .walt-video .wv-play:after { content:""; border-style:solid; border-width:13px 0 13px 22px; border-color:transparent transparent transparent #0d1f3f; margin-left:5px; }
    .walt-video .wv-copy { flex:1; min-width:0; display:flex; flex-direction:column; }
    .walt-video .wv-copy p.wv-eyebrow { color:#fc9615; font-size:12px; font-weight:600; letter-spacing:3px; text-transform:uppercase; margin:0 0 4px; }
    .walt-video .wv-copy p.wv-city { color:#ffd400; font-size:38px; line-height:1.05; font-weight:700; margin:0 0 4px; }
    .walt-video .wv-copy p.wv-sub { color:#dbe6f5; font-size:16px; font-weight:500; margin:0 0 14px; }
    .walt-video .wv-copy h3 { color:#ffd400; font-size:20px; margin:0 0 8px; }
    .walt-video .wv-copy p { margin:0 0 8px; color:#dbe6f5; line-height:1.5; }
    .walt-video .wv-copy a { color:#fff; }
    .walt-video .wv-cta { margin-top:auto; padding-top:14px; border-top:1px solid rgba(255,255,255,.18); }
    .walt-video .wv-stats { display:flex; gap:10px; flex-wrap:wrap; margin:0 0 12px; }
    .walt-video .wv-stat { background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.18); border-radius:8px; padding:8px 12px; text-align:center; min-width:92px; }
    .walt-video .wv-stat b { display:block; font-size:22px; line-height:1; font-weight:700; color:#fff; }
    .walt-video .wv-stat span { display:block; font-size:11px; font-weight:500; letter-spacing:1.5px; text-transform:uppercase; color:#dbe6f5; margin-top:4px; }
    .walt-video .wv-stat.saved b { color:#ffd400; }
    .walt-video .wv-btns { display:flex; gap:10px; flex-wrap:wrap; }
    .walt-video .wv-btn { display:inline-block; padding:12px 18px; border-radius:6px; font-size:16px; font-weight:700; text-decoration:none; line-height:1.2; }
    .walt-video .wv-btn.call { background:#fc9615; color:#0d1f3f; }
    .walt-video .wv-btn.call:hover { background:#ffd400; color:#0d1f3f; }
    .walt-video .wv-btn.form { background:transparent; color:#fff; border:2px solid #fff; }
    .walt-video .wv-btn.form:hover { background:#fff; color:#0d1f3f; }
    .walt-video p.wv-fine { color:#dbe6f5; font-size:13px; margin:8px 0 0; }
    @media (max-width:767px) { .walt-video { flex-direction:column; } .walt-video .wv-frame { flex-basis:auto; width:100%; max-width:240px; margin:0 auto; } .walt-video .wv-copy p.wv-city { font-size:30px; } }
    .installer-card { border:1px solid #fc9615; padding: 16px; margin-bottom: 24px; }
    .installer-card img.logo { max-height: 60px; max-width: 200px; }
    .placeholder-note { background:#fff7ec; border-left:4px solid #fc9615; padding:10px 14px; margin-bottom:20px; font-size:14px; }
    .quote-compare { background:#0d1f3f; color:#fff; border-radius:8px; padding:18px 20px; margin-bottom:20px; }
    .quote-compare-head { font-size:12px; font-weight:700; letter-spacing:2px; text-transform:uppercase; color:#fc9615; margin-bottom:12px; }
    .quote-compare-grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:14px; align-items:stretch; }
    .quote-compare-cell { background:rgba(255,255,255,.06); border-radius:6px; padding:12px 14px; }
    .quote-compare-cell.saved { background:#fc9615; color:#1c1c24; }
    .quote-compare-label { display:block; font-size:12px; line-height:1.3; opacity:.85; margin-bottom:6px; }
    .quote-compare-num { display:block; font-size:28px; font-weight:800; line-height:1.1; }
    .quote-compare-cell.other .quote-compare-num { text-decoration:line-through; text-decoration-thickness:3px; text-decoration-color:#fc9615; opacity:.85; }
    .quote-compare-pct { font-size:14px; font-weight:700; }
    .quote-compare-note { font-size:13px; margin:12px 0 0; opacity:.8; }
    @media (max-width:575px) { .quote-compare-grid { grid-template-columns:1fr; } }
</style>
{% include "partials/project-row-css.njk" %}

<div class="breatcumb-area d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breatcumb-content text-center">
                    <div class="breatcumb-title">
                        <h1>{{ p.title }}</h1>
                    </div>
                    <div class="breatcumb-content-text">
                        <ul>
                            <li>
                                <a href="/">home</a> <i class="fas fa-angle-right"></i>
                                <a href="/all-contractors">CIPP Contractors</a> <i class="fas fa-angle-right"></i>
                                <a href="{{ pg.contractorUrl }}">{{ short }}</a> <i class="fas fa-angle-right"></i>
                                <a href="{{ pg.cityUrl }}">{{ pg.city.name }}, {{ pg.state.name }}</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="blog_area style-two pt-5">
    <div class="container container2">
        <div class="row">
            <div class="col-12 mb-4">
                <h4 class="text-center">CIPP Sewer Lining in <b>{{ pg.city.name }}</b>, <b>{{ pg.state.name }}</b> — completed by Verified Installer <b>{{ short }}</b></h4>
            </div>

            {# LEFT: installer card + service list #}
            <div class="col-lg-2 col-md-3 col-sm-12 d-none d-md-block">
                <div class="installer-card text-center">
                    {% if c.logo %}
                        <a href="{{ pg.contractorUrl }}"><img class="logo mb-2" src="{{ c.logo }}" alt="{{ c.name }}"></a>
                    {% endif %}
                    <div><b>{{ short }}</b> <img src="/images/favicon.png" alt="Verified" style="max-width:18px;"></div>
                    <div style="font-size:12px; color:#777; margin-bottom:8px;">Verified CIPP Installer</div>
                    {% if c.googleRating %}
                        <div style="color:#ffc107;">{% for i in (5 | range) %}<i class="fa fa-star"></i>{% endfor %}</div>
                        <div style="font-size:12px; color:#555;">{{ pg.ratingText }} on Google {% if c.googleReviewCount %} ({{ c.googleReviewCount }}+ reviews){% endif %}</div>
                    {% endif %}
                    <a href="{{ pg.contractorUrl }}" style="display:block; margin-top:8px; font-weight:600;">Installer profile</a>
                    {% if pg.website %}
                        <a href="{{ pg.website }}" target="_blank" rel="noopener" style="display:block; font-size:13px;">Visit {{ pg.host or 'website' }}</a>
                    {% endif %}
                </div>

                {% if c.serviceAreasText %}
                <div class="contact-form-box style-two text-center mb-4 pt-4 pb-4" style="max-width:100%; margin:0px; padding:12px;">
                    <h6 class="mb-3">Service Areas</h6>
                    {{ c.serviceAreasText | nl2br | safe }}
                </div>
                {% endif %}
            </div>

            {# CENTER: the project #}
            <div class="col-lg-7 col-md-6 col-sm-12">
                {% if pg.quote and not pg.video %}
                <div class="quote-compare">
                    <div class="quote-compare-head">What the homeowner saved</div>
                    <div class="quote-compare-grid">
                        <div class="quote-compare-cell other">
                            <span class="quote-compare-label">{{ pg.quote.otherLabel }}</span>
                            <span class="quote-compare-num">{{ pg.quote.otherText }}</span>
                        </div>
                        <div class="quote-compare-cell">
                            <span class="quote-compare-label">{{ pg.quote.priceLabel }}</span>
                            <span class="quote-compare-num">{{ pg.quote.priceText }}</span>
                        </div>
                        <div class="quote-compare-cell saved">
                            <span class="quote-compare-label">Saved</span>
                            <span class="quote-compare-num">{{ pg.quote.savedText }}</span>
                            <span class="quote-compare-pct">{{ pg.quote.pct }}% less</span>
                        </div>
                    </div>
                    <p class="quote-compare-note">{% if pg.quote.note %}{{ pg.quote.note }} {% endif %}Amounts are the actual figures from this job. The other bid came from a different company, which we don't name.</p>
                </div>
                {% endif %}

                {% if pg.facts.length and not pg.video %}
                <div class="project-facts">
                    <dl>
                        {% for f in pg.facts %}
                            <dt>{{ f[0] }}</dt><dd>{{ f[1] }}</dd>
                        {% endfor %}
                    </dl>
                </div>
                {% endif %}

                {% if pg.photos.length and not pg.video %}
                <div class="row project-gallery">
                    {% for ph in pg.photos %}
                        <div class="{{ 'col-12' if pg.photos.length == 1 else 'col-md-6' }}">
                            <img src="{{ ph.src }}" alt="{{ ph.alt }}"{% if ph.generated %} class="generated"{% endif %}>
                        </div>
                    {% endfor %}
                </div>
                {% endif %}

                {% if pg.video %}
                <div class="walt-video">
                    <div class="wv-frame" data-yt="{{ pg.video.id }}" role="button" tabindex="0" aria-label="Play: {{ pg.video.title }}">
                        <img src="https://i.ytimg.com/vi/{{ pg.video.id }}/oar2.jpg" alt="{{ pg.video.title }}" loading="lazy" width="220" height="391" onerror="this.src='https://i.ytimg.com/vi/{{ pg.video.id }}/hqdefault.jpg'">
                        <span class="wv-play" aria-hidden="true"></span>
                    </div>
                    <div class="wv-copy">
                        <p class="wv-eyebrow">Completed trenchless project</p>
                        <p class="wv-city">{{ pg.video.place }}</p>
                        <p class="wv-sub">{{ pg.video.method }} &middot; completed by {{ short }}</p>
                        <h3>Watch Walt tell the story</h3>
                        <p>Walt &ldquo;Dug&rdquo; Dugan spent 40 years in sewers. Now he tells one real trenchless job per episode &mdash; this is the {{ pg.city.name }} one, in under a minute.</p>
                        <div class="wv-cta">
                            <div class="wv-stats">
                                {% if pg.video.footage %}<div class="wv-stat"><b>{{ pg.video.footage }}</b><span>Pipe lined</span></div>{% endif %}
                                {% if pg.video.pits === 0 %}<div class="wv-stat"><b>0</b><span>Holes dug</span></div>{% elif pg.video.pits %}<div class="wv-stat"><b>{{ pg.video.pits }}</b><span>Access pit{{ 's' if pg.video.pits > 1 }}</span></div>{% endif %}
                                {% if pg.video.saved %}<div class="wv-stat saved"><b>{{ pg.video.saved }}</b><span>Saved vs. dig bid</span></div>{% endif %}
                            </div>
                            <div class="wv-btns">
                                {% if pg.phone %}<a class="wv-btn call" href="tel:{{ pg.phone | phoneDigits }}">Call {{ pg.phone }}</a>{% endif %}
                                <a class="wv-btn form" href="#estimate">Get a free estimate</a>
                            </div>
                            <p class="wv-fine">Estimates are free. Same crew, same no-dig method, anywhere {{ short }} works.</p>
                        </div>
                    </div>
                </div>
                <script>
                document.addEventListener("DOMContentLoaded",function(){var f=document.querySelector(".walt-video .wv-frame");if(!f)return;function go(){if(f.dataset.on)return;f.dataset.on=1;var i=document.createElement("iframe");i.src="https://www.youtube-nocookie.com/embed/"+f.dataset.yt+"?autoplay=1&playsinline=1&rel=0";i.allow="autoplay; encrypted-media; picture-in-picture";i.allowFullscreen=true;i.title=f.getAttribute("aria-label");f.innerHTML="";f.appendChild(i);}f.addEventListener("click",go);f.addEventListener("keydown",function(e){if(e.key==="Enter"||e.key===" "){e.preventDefault();go();}});});
                </script>
                {% endif %}

                {% if p.summary %}
                    <p class="lead" style="font-size:18px;">{{ p.summary }}</p>
                {% endif %}

                <div class="project-body">
                    {{ p.body | safe }}
                </div>

                <div class="mt-4 mb-4" style="border-top:1px solid #eee; padding-top:16px;">
                    <p>
                        Need the same result at your property in {{ pg.city.name }}?
                        {% if pg.phone %}Call {{ short }} at <a href="tel:{{ pg.phone | phoneDigits }}"><b>{{ pg.phone }}</b></a> or {% else %} Use {% endif %}
                        the form to request a free estimate. {% if pg.phone %}<b>Estimates are free. Call now.</b>{% endif %} See more work on the
                        <a href="{{ pg.contractorUrl }}">{{ short }} verified installer profile</a>,
                        or compare <a href="{{ pg.cityUrl }}">all CIPP contractors serving {{ pg.city.name }}</a>.
                    </p>
                </div>

                {% if pg.more.length %}
                <h3 style="font-size:20px; margin-bottom:12px;">More {{ short }} projects</h3>
                <div class="project-rows">
                    {% for row in pg.more %}
                        {% include "partials/project-row.njk" %}
                    {% endfor %}
                </div>
                <p class="mt-3"><a href="{{ pg.contractorUrl }}#projects" style="font-weight:600;">All {{ short }} projects <i class="fas fa-angle-right"></i></a></p>
                {% endif %}
            </div>

            {# RIGHT: attributed estimate form #}
            <div class="col-lg-3 col-md-3 col-sm-12" id="estimate">
                {% set est_contractor = c %}
                {% set est_phone = pg.phone %}
                {% set est_city = pg.city %}
                {% set est_state = pg.state %}
                {% set est_project = p %}
                {% include "partials/estimate-sidebar.njk" %}
                {% set rv_contractor = c %}
                {% set rv_reviews = pg.reviews %}
                {% set rv_city = pg.reviewsCity %}
                {% set rv_rating = pg.ratingText %}
                {% include "partials/reviews-sidebar.njk" %}
                {% set vc_short = short %}
                {% include "partials/video-card.njk" %}
            </div>
        </div>
    </div>
</div>
