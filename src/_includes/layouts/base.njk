<script>
$(document).ready(function() {
    $('.blog_list.owl-carousel').owlCarousel({
        loop: true,
        margin: 30,
        nav: true,
        dots: false,
        autoplay: true,
        smartSpeed: 700,
        responsive: {
            0:   { items: 1 },
            600: { items: 2 },
            1000:{ items: 3 }
        }
    });
});
</script>

<script>
// Search overlay: verified installers covering a state → profile links.
// Replaces POST /fetch-installers with data baked in at build time.
var INSTALLERS_BY_STATE = {{ model.installersByState | jsonld | safe }};
function go_to_installer() {
    var slug = $("#find_contractors_field").val();
    if (slug) window.location = "/contractor/" + slug;
}
function fetch_installers(el) {
    var field = $("#find_contractors_field");
    var rows = INSTALLERS_BY_STATE[$(el).val()] || [];
    if (!rows.length) { field.html("<option value=''>No verified installer yet</option>"); return; }
    var html = "<option value='' selected>Select a verified installer</option>";
    rows.forEach(function (r) { html += "<option value='" + r.slug + "'>" + $('<div>').text(r.name).html() + "</option>"; });
    field.html(html);
    // Exactly one installer in the state: go straight to the profile.
    if (rows.length === 1) window.location = "/contractor/" + rows[0].slug;
}
</script>

<script>
// Forms post to Web3Forms (https://web3forms.com) with a redirect to /thank-you.
// Buttons are disabled while the browser submits so a double-tap can't send twice.
document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('form[data-w3f]').forEach(function (form) {
        form.addEventListener('submit', function () {
            var btn = form.querySelector('button[type="submit"]');
            if (btn) { btn.disabled = true; btn.dataset.label = btn.innerHTML; btn.innerHTML = 'Sending...'; }
        });
    });
});
</script>
</body>
</html>
