---
layout: layouts/base.njk
pagination:
  data: model.cityPages
  size: 1
  alias: pg
permalink: "{{ pg.url }}.html"
clickcease: true
eleventyComputed:
  pageTitle: "{{ pg.title | safe }}"
  pageDescription: "{{ pg.description | safe }}"
  h1: "{{ pg.h1 | safe }}"
---
{#- Port of resources/views/home/find_contractors.blade.php -#}
{%- set hero_image = "/images/cipp/cipp-old-pipe.jpg" -%}
{% include "partials/breadcrumb-css.njk" %}
<style>
    @media (min-width:1200px) {
        .container2 {
            max-width: 1350px;
        }
    }

    /* Normalize spacing for city landing page content */
    .city-content p {
        margin: 0 0 10px;
        line-height: 1.6;
    }

    .city-content h2,
    .city-content h3,
    .city-content h4,
    .city-content h5 {
        margin-top: 24px;
        margin-bottom: 8px;
    }

    /* Rewritten city articles */
    .city-content .callout {
        background: #f2f7fb;
        border-left: 3px solid #0b5d8f;
        padding: 2px 18px;
        margin: 22px 0;
        border-radius: 0 6px 6px 0;
    }

    .city-content ul {
        padding-left: 20px;
        margin: 0 0 14px;
    }

    .city-content ul li {
        margin: 6px 0;
        line-height: 1.6;
    }

    .city-faq details {
        border-top: 1px solid #e3e7eb;
        padding: 12px 0;
    }

    .city-faq details:last-child {
        border-bottom: 1px solid #e3e7eb;
    }

    .city-faq summary {
        cursor: pointer;
        font-weight: 700;
    }

    .city-faq details p {
        margin: 8px 0 0;
    }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
    // 1) Clean up empty paragraphs in the city content
    document.querySelectorAll('.city-content p').forEach(function (p) {
        var cleaned = p.innerHTML.replace(/&nbsp;|\s|<br>/gi, '');
        if (cleaned === '') {
            p.remove();
        }
    });

    // 2) Smooth scroll handler for "Read Our Google Reviews" buttons
    document.querySelectorAll('.reviews-trigger').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            var target = document.querySelector('[class^="elfsight-app-"]');
            if (!target) {
                target = document.getElementById('googleReviewsSection');
            }
            if (target) {
                var y = target.getBoundingClientRect().top + window.pageYOffset - 120;
                window.scrollTo({ top: y, behavior: 'smooth' });
            }
        });
    });
});
</script>

