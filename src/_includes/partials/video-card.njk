{#- Port of common/video/_sidebar_card.blade.php. Context: vc_short (contractor short name|null) -#}
{% if video.youtubeId %}
<style>
    .cipp-video-card { background:#fff; border:1px solid #e6e6e6; border-radius:8px; overflow:hidden; margin-top:24px; }
    .cipp-video-thumb { position:relative; display:block; padding-top:56.25%; background:#000 center/cover no-repeat; }
    .cipp-video-thumb .play { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:58px; height:58px; border-radius:50%; background:#fc9615; color:#fff; display:flex; align-items:center; justify-content:center; font-size:22px; box-shadow:0 6px 18px rgba(0,0,0,.35); transition:transform .15s; }
    .cipp-video-thumb .play i { margin-left:4px; }
    .cipp-video-thumb:hover .play { transform:translate(-50%,-50%) scale(1.08); }
    .cipp-video-thumb .dur { position:absolute; right:8px; bottom:8px; background:rgba(0,0,0,.75); color:#fff; font-size:12px; padding:2px 6px; border-radius:3px; }
    .cipp-video-body { padding:14px 16px 16px; }
    .cipp-video-body h4 { font-size:16px; margin:0 0 6px; color:#1c1c24; }
    .cipp-video-body p { font-size:13px; color:#666; margin:0; line-height:1.5; }
</style>
<div class="cipp-video-card">
    <a href="{{ video.embedPage }}" class="cipp-video-thumb" style="background-image:url('https://i.ytimg.com/vi/{{ video.youtubeId }}/hqdefault.jpg')" onclick="openCippVideo(); return false;" aria-label="Watch: how CIPP lining works">
        <span class="play"><i class="fas fa-play"></i></span>
        <span class="dur">{{ video.durationLabel }}</span>
    </a>
    <div class="cipp-video-body">
        <h4>Watch: how CIPP lining works</h4>
        <p>A {{ video.durationLabel }} animation of the no-dig process {% if vc_short %}{{ vc_short }} uses {% else %}our verified installers use {% endif %}to build a new pipe inside the old one.</p>
    </div>
</div>
{% endif %}
