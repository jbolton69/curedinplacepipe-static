---
layout: layouts/base.njk
pagination:
  data: model.projectPages
  size: 1
  alias: pg
permalink: "{{ pg.url }}.html"
eleventyComputed:
  pageTitle: "{{ pg.title | safe }}"
  pageDescription: "{{ pg.description | safe }}"
  h1: "{{ pg.h1 | safe }}"
---
{#- Port of resources/views/contractor/project.blade.php -#}
{%- set c = pg.c -%}
{%- set p = pg.p -%}
{%- set short = pg.short -%}
{%- set hero_image = "/images/cipp/cipp-liner-equipment.jpg" -%}
{% include "partials/breadcrumb-css.njk" %}
<style>
    @media (min-width:1200px) { .container2 { max-width: 1350px; } }
    .project-body p { margin: 0 0 10px; line-height: 1.6; }
    .project-body h2, .project-body h3, .project-body h4 { margin-top: 24px; margin-bottom: 8px; }
    .project-facts { border:1px solid #fc9615; padding: 14px 16px; margin-bottom: 20px; }
    .project-facts dl { margin: 0; display: grid; grid-template-columns: max-content 1fr; gap: 4px 14px; }
    .project-facts dt { font-weight: 600; color: #333; }
    .project-facts dd { margin: 0; color: #555; }
    .project-gallery img { width: 100%; height: 220px; object-fit: cover; border-radius: 6px; margin-bottom: 14px; }
    .installer-card { border:1px solid #fc9615; padding: 16px; margin-bottom: 24px; }
    .installer-card img.logo { max-height: 60px; max-width: 200px; }
    .placeholder-note { background:#fff7ec; border-left:4px solid #fc9615; padding:10px 14px; margin-bottom:20px; font-size:14px; }
</style>
{% include "partials/project-row-css.njk" %}

<div class="breatcumb-area d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breatcumb-content text-center">
                    <div class="breatcumb-title">
                        <h1>{{ p.title }}</h1>
                    </div>
                    <div class="breatcumb-content-text">
                        <ul>
                            <li>
                                <a href="/">home</a> <i class="fas fa-angle-right"></i>
                                <a href="/all-contractors">CIPP Contractors</a> <i class="fas fa-angle-right"></i>
                                <a href="{{ pg.contractorUrl }}">{{ short }}</a> <i class="fas fa-angle-right"></i>
                                <a href="{{ pg.cityUrl }}">{{ pg.city.name }}, {{ pg.state.name }}</a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="blog_area style-two pt-5">
    <div class="container container2">
        <div class="row">
            <div class="col-12 mb-4">
                <h4 class="text-center">CIPP Sewer Lining in <b>{{ pg.city.name }}</b>, <b>{{ pg.state.name }}</b> — completed by Verified Installer <b>{{ short }}</b></h4>
            </div>

            {# LEFT: installer card + service list #}
            <div class="col-lg-2 col-md-3 col-sm-12 d-none d-md-block">
                <div class="installer-card text-center">
                    {% if c.logo %}
                        <a href="{{ pg.contractorUrl }}"><img class="logo mb-2" src="{{ c.logo }}" alt="{{ c.name }}"></a>
                    {% endif %}
                    <div><b>{{ short }}</b> <img src="/images/favicon.png" alt="Verified" style="max-width:18px;"></div>
                    <div style="font-size:12px; color:#777; margin-bottom:8px;">Verified CIPP Installer</div>
                    {% if c.googleRating %}
                        <div style="color:#ffc107;">{% for i in (5 | range) %}<i class="fa fa-star"></i>{% endfor %}</div>
                        <div style="font-size:12px; color:#555;">{{ pg.ratingText }} on Google {% if c.googleReviewCount %} ({{ c.googleReviewCount }}+ reviews){% endif %}</div>
                    {% endif %}
                    <a href="{{ pg.contractorUrl }}" style="display:block; margin-top:8px; font-weight:600;">Installer profile</a>
                    {% if pg.website %}
                        <a href="{{ pg.website }}" target="_blank" rel="noopener" style="display:block; font-size:13px;">Visit {{ pg.host or 'website' }}</a>
                    {% endif %}
                </div>

                {% if c.serviceAreasText %}
                <div class="contact-form-box style-two text-center mb-4 pt-4 pb-4" style="max-width:100%; margin:0px; padding:12px;">
                    <h6 class="mb-3">Service Areas</h6>
                    {{ c.serviceAreasText | nl2br | safe }}
                </div>
                {% endif %}
            </div>

            {# CENTER: the project #}
            <div class="col-lg-7 col-md-6 col-sm-12">
                {% if pg.facts.length %}
                <div class="project-facts">
                    <dl>
                        {% for f in pg.facts %}
                            <dt>{{ f[0] }}</dt><dd>{{ f[1] }}</dd>
                        {% endfor %}
                    </dl>
                </div>
                {% endif %}

                {% if pg.photos.length %}
                <div class="row project-gallery">
                    {% for ph in pg.photos %}
                        <div class="{{ 'col-12' if pg.photos.length == 1 else 'col-md-6' }}">
                            <img src="{{ ph.src }}" alt="{{ ph.alt }}">
                        </div>
                    {% endfor %}
                </div>
                {% endif %}

                {% if p.summary %}
                    <p class="lead" style="font-size:18px;">{{ p.summary }}</p>
                {% endif %}

                <div class="project-body">
                    {{ p.body | safe }}
                </div>

                <div class="mt-4 mb-4" style="border-top:1px solid #eee; padding-top:16px;">
                    <p>
                        Need the same result at your property in {{ pg.city.name }}?
                        {% if pg.phone %}Call {{ short }} at <a href="tel:{{ pg.phone | phoneDigits }}"><b>{{ pg.phone }}</b></a> or {% else %} Use {% endif %}
                        the form to request a free estimate. {% if pg.phone %}<b>Estimates are free. Call now.</b>{% endif %} See more work on the
                        <a href="{{ pg.contractorUrl }}">{{ short }} verified installer profile</a>,
                        or compare <a href="{{ pg.cityUrl }}">all CIPP contractors serving {{ pg.city.name }}</a>.
                    </p>
                </div>

                {% if pg.more.length %}
                <h3 style="font-size:20px; margin-bottom:12px;">More {{ short }} projects</h3>
                <div class="project-rows">
                    {% for row in pg.more %}
                        {% include "partials/project-row.njk" %}
                    {% endfor %}
                </div>
                <p class="mt-3"><a href="{{ pg.contractorUrl }}#projects" style="font-weight:600;">All {{ short }} projects <i class="fas fa-angle-right"></i></a></p>
                {% endif %}
            </div>

            {# RIGHT: attributed estimate form #}
            <div class="col-lg-3 col-md-3 col-sm-12">
                {% set est_contractor = c %}
                {% set est_phone = pg.phone %}
                {% set est_city = pg.city %}
                {% set est_state = pg.state %}
                {% set est_project = p %}
                {% include "partials/estimate-sidebar.njk" %}
                {% set rv_contractor = c %}
                {% set rv_reviews = pg.reviews %}
                {% set rv_city = pg.reviewsCity %}
                {% set rv_rating = pg.ratingText %}
                {% include "partials/reviews-sidebar.njk" %}
                {% set vc_short = short %}
                {% include "partials/video-card.njk" %}
            </div>
        </div>
    </div>
</div>
