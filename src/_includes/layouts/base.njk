<!-- Search Popup -->
<style>
    .search-popup { background-color: rgba(252,150,21,0.9); }
</style>

<div class="search-popup">
    <button class="close-search style-two">
        <i class="far fa-times-circle"></i>
    </button>

    <button class="close-search">
        <i class="fas fa-arrow-up"></i>
    </button>

    <form method="post" action="#" style="background-color:transparent;" onsubmit="return false;">
        <h3 class="text-center text-white mb-4">Find Contractors</h3>

        <div class="form-group mb-2">
            <select class="form-control" id="find_states_field" onchange="fetch_installers(this)" required>
                <option value="">Select a state</option>
                {% for st in model.findStates %}
                <option value="{{ st.name }}">{{ st.name }}</option>
                {% endfor %}
            </select>
        </div>

        <div class="form-group">
            <select class="form-control" id="find_contractors_field" required onchange="go_to_installer()">
                <option value="">Select a state first</option>
            </select>
        </div>
        <p class="text-center text-white mt-3" style="font-size:13px; opacity:.85;">Every installer listed is license-checked and CIPP-verified. Or <a href="/all-contractors" style="color:#fff; text-decoration:underline;">browse all installers by city</a>.</p>
    </form>
</div>

