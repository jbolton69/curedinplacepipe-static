---
layout: layouts/base.njk
---
{#- Port of resources/views/pages/index.blade.php -#}
<style>
    .breatcumb-area {
        background: #f1f6fc url("/images/resource/case.jpg");
    }
</style>

<div class="breatcumb-area d-flex align-items-center">
	<div class="container">
		<div class="row">
			<div class="col-lg-12">
				<div class="breatcumb-content text-center">
					<div class="breatcumb-title">
						<h1>{{ title | safe }}</h1>
					</div>
					<div class="breatcumb-content-text">
						<ul>
							<li><a href="/">home</a> <i class="fas fa-angle-right"></i> <span>{{ title | safe }}</span></li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<div class="widget-service-area pt-100 pb-60">
	<div class="container">
		<div class="row">
			<div class="col-lg-4 col-md-6 col-sm-12">
				<div class="widget-service-box">
					<div class="widget-service-menu">
						<ul>
                            {% for info in collections.navPages %}
							<li>
                                <a class="{{ 'current' if info.url == page.url else '' }}" href="{{ info.url | cleanUrl }}">{{ info.data.title }} <i class="fas fa-angle-right"></i></a>
                            </li>
                            {% endfor %}
						</ul>
					</div>
				</div>
			</div>
			<div class="col-lg-8 col-md-6 col-sm-12">
                {% if (page.url | cleanUrl) == video.embedPage %}
                {% include "partials/video-embed.njk" %}
                {% endif %}
                {{ content | safe }}
			</div>
		</div>
	</div>
</div>
