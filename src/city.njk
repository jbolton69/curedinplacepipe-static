							<li><a href="/">home</a> <i class="fas fa-angle-right"></i> <span>CIPP Contractors</span> <i class="fas fa-angle-right"></i> <span>{{ pg.state.name }}</span> <i class="fas fa-angle-right"></i> <span>{{ pg.city.name }}</span></li>
						</ul>
