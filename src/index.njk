{% if model.home.recentProjects.length %}
<style>
    .home-projects { display:grid; grid-template-columns:repeat(3, 1fr); gap:24px; }
    .home-project { display:flex; flex-direction:column; background:#fff; border:1px solid #e6e6e6; border-top:4px solid #fc9615; border-radius:8px; overflow:hidden; text-decoration:none; color:inherit; transition:box-shadow .15s, transform .15s; }
    .home-project:hover { box-shadow:0 8px 26px rgba(0,0,0,.12); transform:translateY(-2px); color:inherit; text-decoration:none; }
    .home-project-media { height:190px; background:#f1f6fc; display:flex; align-items:center; justify-content:center; }
    .home-project-media img { width:100%; height:100%; object-fit:cover; display:block; }
    .home-project-stat { text-align:center; }
    .home-project-stat-num { display:block; font-size:34px; font-weight:800; color:#fc9615; line-height:1.1; }
    .home-project-stat-label { display:block; font-size:12px; color:#666; text-transform:uppercase; letter-spacing:.5px; margin-top:4px; }
    .home-project-body { padding:16px 18px 18px; display:flex; flex-direction:column; flex:1; }
    .home-project-meta { font-size:12px; color:#777; margin-bottom:6px; }
    .home-project-contractor { color:#1c1c24; font-weight:700; }
    .home-project-title { font-size:17px; font-weight:700; color:#1c1c24; margin:0 0 8px; line-height:1.35; }
    .home-project-summary { font-size:14px; color:#555; line-height:1.55; margin:0 0 12px; flex:1; }
    .home-project-link { font-weight:700; color:#fc9615; font-size:14px; }
    .home-projects-more { text-align:center; margin-top:34px; }
    .home-projects-more a { display:inline-block; background:#1c1c24; color:#fff; padding:12px 30px; border-radius:5px; font-weight:600; }
    .home-projects-more a:hover { background:#fc9615; color:#fff; }
    @media (max-width:991px) { .home-projects { grid-template-columns:repeat(2, 1fr); } }
    @media (max-width:575px) { .home-projects { grid-template-columns:1fr; } }
</style>
<div class="testimonial-area pt-90 pb-90">
	<div class="container">
		<div class="row">
			<div class="col-lg-12 col-sm-12">
				<div class="dreamit-section-title pb-40 text-center">
					<h2>Recent CIPP Sewer Lining Projects</h2>
					<div class="em_bar_bg text-left"></div>
				</div>
			</div>
		</div>
		<div class="home-projects">
			{% for row in model.home.recentProjects %}
				<a href="{{ row.url }}" class="home-project">
					<div class="home-project-media">
						{% if row.photo %}
							<img src="{{ row.photo.src }}" alt="{{ row.photo.alt }}" loading="lazy">
						{% else %}
							<div class="home-project-stat">
								<span class="home-project-stat-num">{{ row.stat }}</span>
								<span class="home-project-stat-label">{{ row.statLabel }}</span>
							</div>
						{% endif %}
					</div>
					<div class="home-project-body">
						<div class="home-project-meta">
							{% if row.contractorShort %}<span class="home-project-contractor">{{ row.contractorShort }}</span>{% if row.homeMeta %} · {% endif %} {% endif %}{{ row.homeMeta }}{% if row.completedLabel %} · {{ row.completedLabel }}{% endif %}
						</div>
						<h4 class="home-project-title">{{ row.title }}</h4>
						{% if row.summary %}<p class="home-project-summary">{{ row.summary120 }}</p>{% endif %}
						<span class="home-project-link">View project <i class="fas fa-angle-right"></i></span>
					</div>
				</a>
			{% endfor %}
		</div>
		<div class="home-projects-more">
			<a href="/all-contractors">See all Verified CIPP Installers</a>
		</div>
	</div>
</div>
{% endif %}

